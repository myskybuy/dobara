# ---------- Database (required) ----------
# Local PostgreSQL. Create the database first:  createdb dobara
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dobara?schema=public"

# ---------- App ----------
APP_URL="http://localhost:3000"

# ---------- Email OTP (optional) ----------
# Leave SMTP_HOST empty in development: the OTP is printed in the terminal
# and also shown on the "Verify email" screen (dev mode only).
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<16-char app password>
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Dobara <no-reply@dobara.local>"

# ---------- Razorpay (optional) ----------
# Leave empty to use DEMO payment mode (a fake payment screen, no money moves).
# Put your Razorpay TEST keys here (Dashboard → Settings → API Keys, test mode) to use real Razorpay test checkout.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
